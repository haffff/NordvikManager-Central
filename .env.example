# Server
PORT=3000
NODE_ENV=development

# Reverse proxies to trust for the client address (X-Forwarded-For): a hop count, true/false,
# or addresses. Defaults to 1 in production (behind LiteSpeed/nginx), none otherwise.
# TRUST_PROXY=1
# Check it: your own requests should show your public address in the access log. With it
# wrong, every client counts as the proxy and shares the limits below.

# Flood limits per client address (0 turns one off). Generous by default: people behind one
# router share an address.
# API_RATE_LIMIT=600                    # /api and /webrtc requests per minute
# SIGNALING_MAX_CONNECTIONS_PER_IP=50   # open signaling sockets at once
# SIGNALING_AUTH_TIMEOUT_MS=20000       # a socket that doesn't authenticate by then is closed
# PASSWORD_CHECKS_MAX=4                 # password hashes/checks at once; more get 503 straight away

# Open registration (NO_INVITATION=true) guard. Turn SIGNUP_CHALLENGE on only once the
# frontend and GM servers that solve the puzzle are deployed: older ones can't register.
# SIGNUP_CHALLENGE=false
# SIGNUP_CHALLENGE_MAX_NUMBER=100000    # puzzle size: ~0.3 s on a desktop, ~3 s on a phone
# SIGNUP_CHALLENGE_MIN_AGE_MS=2000      # an answer sooner than this after the puzzle is refused
# SIGNUP_DAILY_LIMIT=200                # accounts registered without an invite per 24 hours (0 = no cap)

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15m

# Refresh tokens
REFRESH_TOKEN_SECRET=change_me_to_another_long_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Database
DB_PATH=./data/nordvik.db

# Game sessions whose GM server hasn't connected for this many days are deleted, with their
# members (checked hourly). Used refresh tokens and invites expired 30+ days ago are pruned too.
# 0 keeps game sessions forever.
SESSION_EXPIRY_DAYS=90

# CORS — comma-separated list of allowed origins,
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Admin seed (used by: npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately
ADMIN_EMAIL=admin@example.com

# Invitation code requirement 
#set to 'false' to require invite codes for registration, 
#if true anyone can register without an invitation code
NO_INVITATION=false

# Addon repository link
ADDON_REPO=https://github.com/yourusername/your-addon-repo

#Add STUNS ervers for WebRTC
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302,stun:stun3.l.google.com:19302,stun:stun4.l.google.com:19302

# Optional TURN relay (coturn) used when a direct WebRTC connection fails.
# TURN is enabled only when both TURN_URLS and TURN_SECRET are set; peers get short-lived
# credentials from GET /api/ice-servers. TURN_SECRET must equal coturn's static-auth-secret
# (generate with: openssl rand -hex 32). See coturn/turnserver.conf and the docs site.
#TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
#TURN_SECRET=
# Lifetime of issued TURN credentials, in seconds (default 86400 = 24h)
#TURN_TTL_SECONDS=86400

#minimum gm backend version required for compatibility with this central
MIN_GM_BACKEND_VERSION=1.0.0

# Lowest GM backend protocol version allowed to start a session. Older backends are told to update.
# Player clients for each supported protocol live in static/client/p<N>/.
MIN_GM_PROTOCOL=1

# Allow public games, set to 'true' to allow users to create public games without an invitation code
# since this is alpha build, i recommend to keep it false for now, as it may have some security issues
ALLOW_PUBLIC_GAMES=false

# Built docs site, served at /quickstart, /user-guide, /documentation and /addon-guide.
# Defaults to docs-site/build next to this server; on the hosting, set it to the folder
# the docs deploy uploads to (the DOCS_FTP_DIR repo variable), e.g.
# DOCS_DIR=/home/<user>/domains/nordvikmanager.pl/public_html

# The addon registry shown on the public addons page (/addons). Defaults to the main
# registry's addons.json on GitHub.
# ADDON_REGISTRY_URL=https://raw.githubusercontent.com/haffff/NordvikManager-Addons/main/addons.json

# GitHub repo whose releases the landing page's Download section and the GM servers' update
# checks read (/api/releases), and a GitHub token (no scopes needed). Set the token in
# production: without one GitHub allows 60 requests an hour from the server's IP, and once
# that's spent both fail (502) until the limit resets. With one it's 5000 an hour.
# RELEASES_REPO=haffff/NordvikManager
# GITHUB_TOKEN=

# Log level override — defaults to 'debug' in development, 'info' in production
# LOG_LEVEL=debug