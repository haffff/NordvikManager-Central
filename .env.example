# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15m

# Refresh tokens
REFRESH_TOKEN_SECRET=change_me_to_another_long_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Database
DB_PATH=./data/nordvik.db

# CORS — comma-separated list of allowed origins,
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Admin seed (used by: npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately
ADMIN_EMAIL=admin@example.com

# Invitation code requirement 
#set to 'false' to require invite codes for registration, 
#if true anyone can register without an invitation code
NO_INVITATION=false

# Addon repository link
ADDON_REPO=https://github.com/yourusername/your-addon-repo

#Add STUNS ervers for WebRTC
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302,stun:stun3.l.google.com:19302,stun:stun4.l.google.com:19302

#optional TURN Server for fallback
#TURN_SERVER=turn:your.turn.server:3478

#minimum gm backend version required for compatibility with this central
MIN_GM_BACKEND_VERSION=1.0.0

# Allow public games, set to 'true' to allow users to create public games without an invitation code
# since this is alpha build, i recommend to keep it false for now, as it may have some security issues
ALLOW_PUBLIC_GAMES=false

# Log level override — defaults to 'debug' in development, 'info' in production
# LOG_LEVEL=debug